# ==============================================================================
# PharmaFlow Enterprise ERP - Environment Configuration Template
# Copy this file to `.env` and supply valid API credentials for live integrations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Sync (Multi-Device Backup & Disaster Recovery)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# ------------------------------------------------------------------------------
# 2. Cashfree Verification Suite (Live GSTIN Verification & Trade Name Lookup)
# ------------------------------------------------------------------------------
VITE_CASHFREE_CLIENT_ID=CF1181570DBDGAKS3N65S73BH449G
VITE_CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
VITE_CASHFREE_ENV=production # production | sandbox

# ------------------------------------------------------------------------------
# 3. Google Gemini 2.5 Flash Vision (Supplier Purchase Bill AI Scanner)
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your-gemini-api-key-optional
